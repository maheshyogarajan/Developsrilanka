{% extends "admin_v2/layout.html" %}

{% block title %}Dashboard - Admin Panel - Develop Sri Lanka{% endblock %}

{% block admin_content %}
<div class="container-fluid px-4">
    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
        <div>
            <button class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-sync-alt me-1"></i> Refresh
            </button>
            <span class="ms-2 text-muted small">Last updated: {{ now|datetime }}</span>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row mb-4">
        <!-- Users Stat -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="admin-card h-100">
                <div class="admin-stat-card primary position-relative">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-label">Total Users</div>
                    <div class="stat-value">{{ user_count }}</div>
                    <div class="mt-3 small">
                        <i class="fas fa-arrow-up me-1"></i>
                        <span>{{ user_growth_percent|percent }} from last month</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Receipts Stat -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="admin-card h-100">
                <div class="admin-stat-card success position-relative">
                    <div class="stat-icon">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <div class="stat-label">Total Receipts</div>
                    <div class="stat-value">{{ receipt_count }}</div>
                    <div class="mt-3 small">
                        <i class="fas fa-arrow-up me-1"></i>
                        <span>{{ receipt_growth_percent|percent }} from last month</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Total Amount Stat -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="admin-card h-100">
                <div class="admin-stat-card warning position-relative">
                    <div class="stat-icon">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <div class="stat-label">Total Processed</div>
                    <div class="stat-value">{{ total_amount|currency }}</div>
                    <div class="mt-3 small">
                        <i class="fas fa-arrow-up me-1"></i>
                        <span>{{ amount_growth_percent|percent }} from last month</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- System Health Stat -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="admin-card h-100">
                <div class="admin-stat-card {% if system_status == 'Healthy' %}success{% else %}danger{% endif %} position-relative">
                    <div class="stat-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <div class="stat-label">System Health</div>
                    <div class="stat-value">{{ system_status }}</div>
                    <div class="mt-3 small">
                        <i class="fas {% if error_count > 0 %}fa-exclamation-triangle{% else %}fa-check-circle{% endif %} me-1"></i>
                        <span>{{ error_count }} errors in last 24h</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Activity Chart -->
    <div class="row mb-4">
        <div class="col-xl-8 col-lg-7">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="admin-card-title">User Activity</h5>
                    <div>
                        <button class="btn btn-sm btn-link dropdown-toggle" type="button" id="chartTimeRange" data-bs-toggle="dropdown" aria-expanded="false">
                            Last 7 days
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="chartTimeRange">
                            <li><a class="dropdown-item" href="#">Last 7 days</a></li>
                            <li><a class="dropdown-item" href="#">Last 30 days</a></li>
                            <li><a class="dropdown-item" href="#">Last 90 days</a></li>
                        </ul>
                    </div>
                </div>
                <div class="admin-card-body">
                    <div class="chart-container" style="position: relative; height:300px;">
                        <canvas id="userActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h5 class="admin-card-title">Tax Deduction Categories</h5>
                </div>
                <div class="admin-card-body">
                    <div class="chart-container" style="position: relative; height:300px;">
                        <canvas id="taxCategoriesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Activity and Quick Tasks -->
    <div class="row mb-4">
        <div class="col-xl-8 col-lg-7">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="admin-card-title">Recent System Activity</h5>
                    <a href="{{ url_for('admin_logs') }}" class="btn btn-sm btn-link">View All</a>
                </div>
                <div class="admin-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Event</th>
                                    <th>User</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for log in recent_logs %}
                                <tr>
                                    <td>{{ log.event }}</td>
                                    <td>{{ log.user }}</td>
                                    <td>{{ log.timestamp|datetime }}</td>
                                    <td>
                                        <span class="badge rounded-pill bg-{{ log.status_color }}">{{ log.status }}</span>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-3">No recent activity found</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h5 class="admin-card-title">Quick Tasks</h5>
                </div>
                <div class="admin-card-body">
                    <div class="d-grid gap-3">
                        <button class="btn btn-outline-primary d-flex align-items-center justify-content-between px-4 py-3" data-bs-toggle="modal" data-bs-target="#updateTaxRatesModal">
                            <span><i class="fas fa-percentage me-2"></i> Update Tax Rates</span>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        
                        <a href="{{ url_for('admin_clear_temp_files') }}" class="btn btn-outline-warning d-flex align-items-center justify-content-between px-4 py-3">
                            <span><i class="fas fa-broom me-2"></i> Clear Temporary Files</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        
                        <a href="{{ url_for('admin_update_categories') }}" class="btn btn-outline-success d-flex align-items-center justify-content-between px-4 py-3">
                            <span><i class="fas fa-sync me-2"></i> Update Categories</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        
                        <a href="{{ url_for('admin_settings') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-between px-4 py-3">
                            <span><i class="fas fa-cogs me-2"></i> All Settings</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- System Information -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="admin-card-title">System Information</h5>
                </div>
                <div class="admin-card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th style="width: 250px;">Application Version</th>
                                        <td>1.0.0</td>
                                    </tr>
                                    <tr>
                                        <th>Last Database Update</th>
                                        <td>{{ settings_updated }}</td>
                                    </tr>
                                    <tr>
                                        <th>LKR Business Tax Rate</th>
                                        <td>{{ tax_settings.lkr_business_tax_rate|percent }}</td>
                                    </tr>
                                    <tr>
                                        <th>USD Consulting Tax Rate</th>
                                        <td>{{ tax_settings.usd_consulting_tax_rate|percent }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th style="width: 250px;">VAT Rate</th>
                                        <td>{{ tax_settings.vat_rate|percent }}</td>
                                    </tr>
                                    <tr>
                                        <th>SSCL Rate</th>
                                        <td>{{ tax_settings.sscl_rate|percent }}</td>
                                    </tr>
                                    <tr>
                                        <th>Registration Enabled</th>
                                        <td>
                                            <span class="badge rounded-pill {% if general_settings.enable_registration %}bg-success{% else %}bg-danger{% endif %}">
                                                {{ 'Yes' if general_settings.enable_registration else 'No' }}
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>AI Features Enabled</th>
                                        <td>
                                            <span class="badge rounded-pill {% if general_settings.enable_ai_features %}bg-success{% else %}bg-danger{% endif %}">
                                                {{ 'Yes' if general_settings.enable_ai_features else 'No' }}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Tax Rates Modal -->
<div class="modal fade" id="updateTaxRatesModal" tabindex="-1" aria-labelledby="updateTaxRatesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateTaxRatesModalLabel">Update Tax Rates</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="{{ url_for('admin_update_tax_settings') }}" method="post" id="taxRatesForm">
                    <div class="mb-3">
                        <label for="lkrBusinessTaxRate" class="form-label">LKR Business Tax Rate (%)</label>
                        <input type="number" class="form-control" id="lkrBusinessTaxRate" name="lkr_business_tax_rate" 
                               value="{{ tax_settings.lkr_business_tax_rate }}" step="0.1" min="0" max="100">
                    </div>
                    <div class="mb-3">
                        <label for="usdConsultingTaxRate" class="form-label">USD Consulting Tax Rate (%)</label>
                        <input type="number" class="form-control" id="usdConsultingTaxRate" name="usd_consulting_tax_rate" 
                               value="{{ tax_settings.usd_consulting_tax_rate }}" step="0.1" min="0" max="100">
                    </div>
                    <div class="mb-3">
                        <label for="vatRate" class="form-label">VAT Rate (%)</label>
                        <input type="number" class="form-control" id="vatRate" name="vat_rate" 
                               value="{{ tax_settings.vat_rate }}" step="0.1" min="0" max="100">
                    </div>
                    <div class="mb-3">
                        <label for="ssclRate" class="form-label">SSCL Rate (%)</label>
                        <input type="number" class="form-control" id="ssclRate" name="sscl_rate" 
                               value="{{ tax_settings.sscl_rate }}" step="0.1" min="0" max="100">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="taxRatesForm" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Chart.js for data visualization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // User Activity Chart
    const userActivityCtx = document.getElementById('userActivityChart').getContext('2d');
    const userActivityChart = new Chart(userActivityCtx, {
        type: 'line',
        data: {
            labels: {{ user_activity_dates|tojson }},
            datasets: [
                {
                    label: 'New Users',
                    data: {{ user_activity_new|tojson }},
                    borderColor: '#3498db',
                    backgroundColor: 'rgba(52, 152, 219, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                },
                {
                    label: 'Active Users',
                    data: {{ user_activity_active|tojson }},
                    borderColor: '#2ecc71',
                    backgroundColor: 'rgba(46, 204, 113, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                },
                {
                    label: 'Receipts Scanned',
                    data: {{ user_activity_receipts|tojson }},
                    borderColor: '#f39c12',
                    backgroundColor: 'rgba(243, 156, 18, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
    
    // Tax Categories Chart
    const taxCategoriesCtx = document.getElementById('taxCategoriesChart').getContext('2d');
    const taxCategoriesChart = new Chart(taxCategoriesCtx, {
        type: 'doughnut',
        data: {
            labels: {{ category_labels|tojson }},
            datasets: [{
                data: {{ category_values|tojson }},
                backgroundColor: [
                    '#3498db',
                    '#2ecc71',
                    '#f39c12',
                    '#e74c3c',
                    '#9b59b6',
                    '#1abc9c'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                }
            },
            cutout: '65%'
        }
    });
</script>
{% endblock %}