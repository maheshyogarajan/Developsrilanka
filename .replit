modules = ["python-3.11", "python3", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libpng", "libtiff", "libwebp", "libxcrypt", "libyaml", "openjpeg", "tcl", "tk", "which", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "python worker.py & exec gunicorn --bind 0.0.0.0:5000 --timeout 120 --workers 2 main:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'python worker.py & exec gunicorn --bind 0.0.0.0:5000 --timeout 120 --reuse-port --reload main:app'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
